+              const Complex xm=harmonic(w,l,m,-1,thetaIndex,phase);
+              const Complex xpp=l>=2?harmonic(w,l,m,2,thetaIndex,phase):Complex{};
+              const Complex xmm=l>=2?harmonic(w,l,m,-2,thetaIndex,phase):Complex{};
