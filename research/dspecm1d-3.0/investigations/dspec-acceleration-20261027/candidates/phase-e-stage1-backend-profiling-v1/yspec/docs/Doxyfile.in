PROJECT_NAME           = "YSpec"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Synthetic seismograms for spherically symmetric \
earth models by direct radial integration"
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIR@
INPUT                  = @DOXYGEN_INPUT_DIR@ @PROJECT_SOURCE_DIR@/README.md
USE_MDFILE_AS_MAINPAGE = @PROJECT_SOURCE_DIR@/README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = @DOXYGEN_OUTPUT_DIR@/doxygen-warnings.log
JAVADOC_AUTOBRIEF      = YES
BUILTIN_STL_SUPPORT    = YES
EXCLUDE_SYMBOLS        = *Details *Details::*
HAVE_DOT               = NO
GENERATE_HTML          = YES
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
MATHJAX_RELPATH        = https://cdn.jsdelivr.net/npm/mathjax@3
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
