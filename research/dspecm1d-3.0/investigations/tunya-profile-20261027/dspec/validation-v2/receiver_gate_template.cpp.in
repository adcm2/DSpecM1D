// Exact source bindings:
// v4 @V4_HEADER@:@V4_RECEIVER_LINE@, harmonic at :@V4_HARMONIC_LINE@
//     sha256 @V4_SHA256@
// v6 @V6_HEADER@:@V6_RECEIVER_LINE@, estimator at :@V6_ESTIMATOR_LINE@
//     sha256 @V6_SHA256@
// Extracted method bodies are preserved verbatim. Old-v4 amplitude differences
// are diagnostics; independent v6 correctness is gated against long-double rho.
#include <Eigen/Core>
#include <GSHTrans/Wigner.hpp>
#include <algorithm>
#include <array>
#include <bit>
#include <chrono>
#include <cmath>
#include <complex>
#include <cstddef>
#include <cstdint>
#include <iomanip>
#include <initializer_list>
#include <iostream>
#include <limits>
#include <string>
