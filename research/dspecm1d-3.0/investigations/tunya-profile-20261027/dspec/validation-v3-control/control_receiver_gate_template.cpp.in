namespace {
using Complex = std::complex<double>;
constexpr std::uint64_t signBit = std::uint64_t{1} << 63;
static_assert(std::numeric_limits<long double>::digits >
              std::numeric_limits<double>::digits,
              "independent pole oracle requires extended-precision long double");

std::uint64_t orderedBits(double value) {
  const auto bits = std::bit_cast<std::uint64_t>(value);
  return (bits & signBit) ? (~bits + 1) : (bits | signBit);
}

std::uint64_t ulpDistance(double left, double right) {
  const auto a = orderedBits(left), b = orderedBits(right);
  return a > b ? a-b : b-a;
}

double oracleRho(int degree) {
  const long double pi = std::acos(-1.0L);
  return static_cast<double>(std::sqrt((2.0L*degree+1.0L)/(4.0L*pi)));
}

Eigen::MatrixXcd analyticReceiver(bool spheroidal, int degree) {
  const double rho = oracleRho(degree);
  Eigen::MatrixXcd expected = Eigen::MatrixXcd::Zero(3,3);
  if (spheroidal) {
    expected(0,1) = rho;
    expected(1,0) = -rho; expected(1,2) = rho;
    expected(2,0) = Complex(0.0,-rho); expected(2,2) = Complex(0.0,-rho);
  } else {
    expected(1,0) = Complex(0.0,rho); expected(1,2) = Complex(0.0,rho);
    expected(2,0) = -rho; expected(2,2) = rho;
  }
  return expected;
}

struct Check {
  double maxAbsolute = 0.0;
  double scaled = 0.0;
  bool finite = false;
  bool pass = false;
};

Check comparePole(const Eigen::MatrixXcd &actual,
                  const Eigen::MatrixXcd &expected, double rho) {
  Check result;
  result.finite = actual.rows() == 3 && actual.cols() == 3 &&
                  actual.allFinite() && expected.allFinite();
  if (!result.finite) return result;
  bool entriesPass = true;
  for (Eigen::Index row=0; row<3; ++row) {
    for (Eigen::Index col=0; col<3; ++col) {
      const Complex got = actual(row,col), want = expected(row,col);
      result.maxAbsolute = std::max(result.maxAbsolute,std::abs(got-want));
      if (want == Complex{}) {
        entriesPass = entriesPass && got == Complex{};
      } else {
        entriesPass = entriesPass &&
            (want.real() == 0.0 ? got.real() == 0.0 : ulpDistance(got.real(),want.real()) <= 8) &&
            (want.imag() == 0.0 ? got.imag() == 0.0 : ulpDistance(got.imag(),want.imag()) <= 8);
      }
    }
  }
  result.scaled = result.maxAbsolute/rho;
  result.pass = entriesPass && std::isfinite(result.scaled);
  return result;
}

struct FamilyResult {
  Check control, v6, pair;
  bool pass = false;
};

FamilyResult check(int degree, bool spheroidal) {
  const auto controlFamily = spheroidal ? control_v4::SensitivitySolveFamily::Spheroidal
                                        : control_v4::SensitivitySolveFamily::Toroidal;
  const auto v6Family = spheroidal ? v6::SensitivitySolveFamily::Spheroidal
                                   : v6::SensitivitySolveFamily::Toroidal;
  const Eigen::MatrixXcd controlValue = control_v4::receiverAtPole(controlFamily,degree);
  const Eigen::MatrixXcd v6Value = v6::receiverAtPole(v6Family,degree);
  const Eigen::MatrixXcd expected = analyticReceiver(spheroidal,degree);
  const double rho = oracleRho(degree);
  FamilyResult result;
  result.control = comparePole(controlValue,expected,rho);
  result.v6 = comparePole(v6Value,expected,rho);
  result.pair = comparePole(controlValue,v6Value,rho);
  result.pass = result.control.pass && result.v6.pass && result.pair.pass;
  return result;
}
}

