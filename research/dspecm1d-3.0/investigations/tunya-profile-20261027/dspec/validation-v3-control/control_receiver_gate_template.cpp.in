      const FamilyResult result = check(degree,spheroidal);
      const char *family = spheroidal ? "spheroidal" : "toroidal";
      std::cout << "receiver," << degree << ',' << family << ',' << oracleRho(degree) << ','
                << result.control.maxAbsolute << ',' << result.control.scaled << ','
