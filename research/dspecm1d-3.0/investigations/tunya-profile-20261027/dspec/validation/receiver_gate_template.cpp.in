namespace v4 {
using Complex = std::complex<double>;
enum class SensitivitySolveFamily { Radial, Spheroidal, Toroidal };
@V4_HARMONIC@
@V4_RECEIVER@
}

namespace v6 {
using Complex = std::complex<double>;
enum class SensitivitySolveFamily { Radial, Spheroidal, Toroidal };
@V6_RECEIVER@
@V6_ESTIMATOR@
}

namespace {
using Complex = std::complex<double>;
constexpr double scaledTolerance = 2.0e-14;
constexpr double oldForbiddenTolerance = 5.0e-15;
constexpr std::uint64_t signBit = std::uint64_t{1} << 63;

std::uint64_t orderedBits(double value) {
  const auto bits = std::bit_cast<std::uint64_t>(value);
  return (bits & signBit) ? (~bits + 1) : (bits | signBit);
}

std::uint64_t ulpDistance(double left, double right) {
  const auto a = orderedBits(left), b = orderedBits(right);
  return a > b ? a-b : b-a;
}

struct MatrixCheck {
  double maxAbsolute = 0.0;
  double scaled = 0.0;
  double forbiddenMaximum = 0.0;
  bool finite = false;
  bool pass = false;
};

struct Result {
  double rho = 0.0;
  double oldNewMaximum = 0.0;
  double oldNewScaled = 0.0;
  double oldNanoseconds = 0.0;
  double newNanoseconds = 0.0;
  MatrixCheck oldOracle, newOracle;
  bool pass = false;
};

template <class Function>
double medianNanoseconds(Function function, int repetitions) {
  std::vector<double> samples;
  samples.reserve(static_cast<std::size_t>(repetitions));
  for (int i = 0; i < repetitions; ++i) {
    const auto start = std::chrono::steady_clock::now();
    function();
    const auto stop = std::chrono::steady_clock::now();
    samples.push_back(std::chrono::duration<double, std::nano>(stop-start).count());
  }
  std::sort(samples.begin(), samples.end());
  return samples[samples.size()/2];
}

// Analytic pole matrices for columns m=(-1,0,+1), derived from
// Y^L_nm(0,0)=rho*delta(n,m) and the six documented S/T component channels.
Eigen::MatrixXcd analyticReceiver(bool spheroidal, int degree) {
  const double rho = std::sqrt((2.0*degree+1.0)/(4.0*EIGEN_PI));
  Eigen::MatrixXcd expected = Eigen::MatrixXcd::Zero(3,3);
  if (spheroidal) {
    expected(0,1) = rho;
    expected(1,0) = -rho; expected(1,2) = rho;
    expected(2,0) = Complex(0.0,-rho); expected(2,2) = Complex(0.0,-rho);
  } else {
    expected(1,0) = Complex(0.0,rho); expected(1,2) = Complex(0.0,rho);
    expected(2,0) = -rho; expected(2,2) = rho;
  }
  return expected;
}

MatrixCheck compareOracle(const Eigen::MatrixXcd &actual,
                          const Eigen::MatrixXcd &expected,
                          double rho, bool requireExactZeros) {
  MatrixCheck result;
  result.finite = actual.rows() == expected.rows() && actual.cols() == expected.cols() &&
                  actual.allFinite() && expected.allFinite();
  if (!result.finite) return result;
  bool componentsPass = true, zerosPass = true;
  for (Eigen::Index row = 0; row < actual.rows(); ++row) {
    for (Eigen::Index column = 0; column < actual.cols(); ++column) {
      const auto got = actual(row,column), want = expected(row,column);
      const double error = std::abs(got-want);
      result.maxAbsolute = std::max(result.maxAbsolute,error);
      if (want == std::complex<double>{}) {
        result.forbiddenMaximum = std::max(result.forbiddenMaximum,std::abs(got));
        if (requireExactZeros) zerosPass = zerosPass && got == std::complex<double>{};
        else zerosPass = zerosPass && std::abs(got) <= oldForbiddenTolerance*rho;
      } else {
        if (want.real() == 0.0) {
          if (requireExactZeros) componentsPass = componentsPass && got.real() == 0.0;
          else componentsPass = componentsPass && std::abs(got.real()) <= oldForbiddenTolerance*rho;
        } else {
          componentsPass = componentsPass && ulpDistance(got.real(),want.real()) <= 8;
        }
        if (want.imag() == 0.0) {
          if (requireExactZeros) componentsPass = componentsPass && got.imag() == 0.0;
          else componentsPass = componentsPass && std::abs(got.imag()) <= oldForbiddenTolerance*rho;
        } else {
          componentsPass = componentsPass && ulpDistance(got.imag(),want.imag()) <= 8;
        }
      }
    }
  }
  result.scaled = result.maxAbsolute/rho;
  result.pass = result.finite && componentsPass && zerosPass &&
                std::isfinite(result.scaled) && result.scaled <= scaledTolerance;
  return result;
}

bool checkHarmonicIndicators(int degree) {
  const double rho = std::sqrt((2.0*degree+1.0)/(4.0*EIGEN_PI));
  bool pass = true;
  for (int n = -2; n <= 2; ++n) {
    for (int m = -2; m <= 2; ++m) {
      if (std::abs(n) > degree || std::abs(m) > degree) continue;
      const std::complex<double> expected = n == m ? std::complex<double>(rho,0.0)
                                                    : std::complex<double>{};
      const auto actual = v4::harmonic(degree,m,n,0.0,0.0);
      const double error = std::abs(actual-expected);
      bool entryPass;
      if (expected == std::complex<double>{})
        entryPass = error <= oldForbiddenTolerance*rho;
      else
        entryPass = ulpDistance(actual.real(),rho) <= 8 &&
                    std::abs(actual.imag()) <= oldForbiddenTolerance*rho;
      pass = pass && std::isfinite(actual.real()) && std::isfinite(actual.imag()) && entryPass;
      std::cout << "indicator," << degree << ',' << n << ',' << m << ','
                << expected.real() << ',' << expected.imag() << ','
                << actual.real() << ',' << actual.imag() << ',' << error << ','
                << (entryPass ? "PASS" : "FAIL") << '\n';
    }
  }
  return pass;
}

Result compare(int degree, bool spheroidal) {
  const auto oldFamily = spheroidal ? v4::SensitivitySolveFamily::Spheroidal
                                    : v4::SensitivitySolveFamily::Toroidal;
  const auto newFamily = spheroidal ? v6::SensitivitySolveFamily::Spheroidal
                                    : v6::SensitivitySolveFamily::Toroidal;
  const Eigen::MatrixXcd oldValue = v4::receiverAtPole(oldFamily,degree);
  const Eigen::MatrixXcd newValue = v6::receiverAtPole(newFamily,degree);
  const Eigen::MatrixXcd expected = analyticReceiver(spheroidal,degree);
  Result result;
  result.rho = std::sqrt((2.0*degree+1.0)/(4.0*EIGEN_PI));
  result.oldOracle = compareOracle(oldValue,expected,result.rho,false);
  result.newOracle = compareOracle(newValue,expected,result.rho,true);
  if (oldValue.rows() == newValue.rows() && oldValue.cols() == newValue.cols() &&
      oldValue.allFinite() && newValue.allFinite()) {
    result.oldNewMaximum = (oldValue-newValue).cwiseAbs().maxCoeff();
    result.oldNewScaled = result.oldNewMaximum/result.rho;
  } else {
    result.oldNewMaximum = std::numeric_limits<double>::infinity();
    result.oldNewScaled = std::numeric_limits<double>::infinity();
  }
  constexpr int repetitions = 3;
  result.oldNanoseconds = medianNanoseconds([&] {
    const Eigen::MatrixXcd value = v4::receiverAtPole(oldFamily,degree);
    (void)value;
  },repetitions);
  result.newNanoseconds = medianNanoseconds([&] {
    const Eigen::MatrixXcd value = v6::receiverAtPole(newFamily,degree);
    (void)value;
  },repetitions);
  result.pass = result.oldOracle.pass && result.newOracle.pass &&
                std::isfinite(result.oldNewScaled) && result.oldNewScaled <= scaledTolerance;
  return result;
}

bool checkPayloadCounts(int degree) {
  const int nMax = std::min(2,degree);
  bool ok = true;
  const std::array<int,2> mBounds{std::min(2,degree),degree};
  for (const int mMax : mBounds) {
    std::size_t expectedValues = 0;
    for (int n = -nMax; n <= nMax; ++n)
      expectedValues += GSHTrans::GSHIndices<GSHTrans::All>(degree,mMax,n).Size();
    const std::size_t expectedBytes = expectedValues*sizeof(double) +
        static_cast<std::size_t>(2*nMax+1)*sizeof(std::size_t);
    const std::size_t estimatedBytes = v6::angularWignerBytesPerAngle(degree,mMax);
    const bool match = expectedBytes == estimatedBytes;
    const bool fullExceedsCap = degree <= 2 || mMax != degree ||
        estimatedBytes > v6::angularWignerBytesPerAngle(degree,std::min(2,degree));
    ok = ok && match && fullExceedsCap;
    std::cout << "payload," << degree << ',' << mMax << ',' << expectedValues << ','
              << expectedBytes << ',' << estimatedBytes << ',' << (match && fullExceedsCap ? "PASS" : "FAIL") << '\n';
  }
  return ok;
}
}

int main() {
  std::cout << std::setprecision(17);
  std::cout << "gate,degree,family,rho,max_abs_old_new,scaled_old_new,max_abs_v4_oracle,scaled_v4_oracle,"
               "max_abs_v6_oracle,scaled_v6_oracle,v4_forbidden_max,v6_forbidden_max,"
               "old_median_ns,new_median_ns,status\n";
  bool passed = true;
  for (const int degree : {1,2,3,12,384,1536}) {
    const bool payloadPass = checkPayloadCounts(degree);
    const bool indicatorPass = checkHarmonicIndicators(degree);
    passed = payloadPass && indicatorPass && passed;
    for (const bool spheroidal : {true,false}) {
      const Result result = compare(degree,spheroidal);
      const char *family = spheroidal ? "spheroidal" : "toroidal";
      const char *status = result.pass ? "PASS" : "FAIL";
      std::cout << "receiver," << degree << ',' << family << ',' << result.rho << ','
                << result.oldNewMaximum << ',' << result.oldNewScaled << ','
                << result.oldOracle.maxAbsolute << ',' << result.oldOracle.scaled << ','
                << result.newOracle.maxAbsolute << ',' << result.newOracle.scaled << ','
                << result.oldOracle.forbiddenMaximum << ',' << result.newOracle.forbiddenMaximum << ','
                << result.oldNanoseconds << ',' << result.newNanoseconds << ',' << status << '\n';
      passed = result.pass && passed;
    }
  }
  return passed ? 0 : 1;
}
