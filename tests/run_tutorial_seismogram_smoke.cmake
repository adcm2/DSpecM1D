if(NOT DEFINED GENERATE_SEISMOGRAM_EXECUTABLE OR NOT DEFINED GENERATE_SEISMOGRAM_PARAM_FILE OR NOT DEFINED GENERATE_SEISMOGRAM_OUTPUT_FILE OR NOT DEFINED GENERATE_SEISMOGRAM_WORKING_DIRECTORY OR NOT DEFINED GENERATE_SEISMOGRAM_CHECKER OR NOT DEFINED GENERATE_SEISMOGRAM_PYTHON)
  message(FATAL_ERROR "All first-seismogram smoke variables are required")
endif()
get_filename_component(_output_dir "${GENERATE_SEISMOGRAM_OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${_output_dir}")
file(REMOVE "${GENERATE_SEISMOGRAM_OUTPUT_FILE}")
execute_process(COMMAND "${GENERATE_SEISMOGRAM_EXECUTABLE}" "${GENERATE_SEISMOGRAM_PARAM_FILE}" "${GENERATE_SEISMOGRAM_OUTPUT_FILE}" WORKING_DIRECTORY "${GENERATE_SEISMOGRAM_WORKING_DIRECTORY}" RESULT_VARIABLE _run_result)
if(NOT _run_result EQUAL 0 OR NOT EXISTS "${GENERATE_SEISMOGRAM_OUTPUT_FILE}")
  message(FATAL_ERROR "first_seismogram tutorial failed: ${_run_result}")
endif()
execute_process(COMMAND "${GENERATE_SEISMOGRAM_PYTHON}" "${GENERATE_SEISMOGRAM_CHECKER}" "${GENERATE_SEISMOGRAM_OUTPUT_FILE}" RESULT_VARIABLE _check_result)
if(NOT _check_result EQUAL 0)
  message(FATAL_ERROR "Tutorial output validation failed: ${_check_result}")
endif()
